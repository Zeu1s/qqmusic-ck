#!name=QQ音乐自动签到
#!desc=抓取 QQ音乐 App 的登录凭证，每天 10:02（北京时间）自动完成金币中心签到（顺带绿钻成长值签到）。脚本托管在 GitHub（Zeu1s/tools），Surge 直接拉取。模块设置里可关「抓取凭证」；手动补签用 Safari 打开 https://qqmusic.201922.xyz/run ；凭证失效时打开抓取开关、开一次 App 刷新即可。
#!system=ios
#!arguments=抓取凭证:true

[Script]
QQ音乐抓凭证 = type=http-request,pattern=^https:\/\/([a-z0-9]+\.)?y\.qq\.com\/,script-path=https://raw.githubusercontent.com/Zeu1s/tools/main/qqmusic-checkin.js,requires-body=true,argument={{{抓取凭证}}}
QQ音乐手动签到 = type=http-request,pattern=^https:\/\/qqmusic\.201922\.xyz\/run,script-path=https://raw.githubusercontent.com/Zeu1s/tools/main/qqmusic-checkin.js,timeout=30
QQ音乐签到 = type=cron,cronexp="2 10 * * *",script-path=https://raw.githubusercontent.com/Zeu1s/tools/main/qqmusic-checkin.js,wake-system=1,timeout=60

[MITM]
hostname = %APPEND% u.y.qq.com, u6.y.qq.com, y.qq.com, qqmusic.201922.xyz
